<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Dedicated access group (PLAN.md, decision D2): grantable to
        developers/consultants without handing out Settings/base.group_system.
        `group_physical` implies `group_user` and gates row counts, table
        sizes and the drift report - details that can themselves be
        sensitive on a client database (PLAN.md, section 14).

        Odoo 19 moved group categorization from `res.groups.category_id`
        (ir.module.category) to `res.groups.privilege_id`
        (res.groups.privilege), which itself points at the category - see
        odoo/addons/base/models/res_groups_privilege.py.
    -->
    <record id="module_category_schema_explorer" model="ir.module.category">
        <field name="name">Schema Explorer</field>
        <field name="description">Access to the module-scoped database schema visualizer.</field>
        <field name="sequence">50</field>
    </record>

    <record id="privilege_schema_explorer" model="res.groups.privilege">
        <field name="name">Schema Explorer access</field>
        <field name="category_id" ref="module_category_schema_explorer"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_schema_explorer_user" model="res.groups">
        <field name="name">User: browse schema (ORM + ownership only)</field>
        <field name="privilege_id" ref="privilege_schema_explorer"/>
        <field name="comment">Can open Schema Explorer and browse the ORM/ownership graph for any module. Cannot see row counts, table sizes or the physical drift report.</field>
    </record>

    <record id="group_schema_explorer_physical" model="res.groups">
        <field name="name">User: include physical database details</field>
        <field name="privilege_id" ref="privilege_schema_explorer"/>
        <field name="implied_ids" eval="[(4, ref('group_schema_explorer_user'))]"/>
        <field name="comment">Also see row counts, table sizes, indexes and the code-vs-database drift report.</field>
    </record>
</odoo>
